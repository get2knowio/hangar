# .git is NOT ignored: hatch-vcs derives the backend version from tag history at
# build time. It is copied only into the discarded `backend-build` stage, so no
# git history reaches the published runtime image.
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/
**/.mypy_cache/
**/.ruff_cache/
**/.pytest_cache/
**/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
**/*.db
**/*.db-shm
**/*.db-wal
.env
deploy/.env
*.key
*.pem
.DS_Store
docs/prototype/screenshots/
