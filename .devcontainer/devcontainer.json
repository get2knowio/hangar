{
    "name": "Python Agentic Development",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers/features/node:1": {
            // Kept equal to mise.toml's `node` pin, ci.yml, and deploy/Dockerfile.
            "version": "26"
        },
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "enableNonRootDocker": "true",
            "moby": "false"
        },
        "ghcr.io/devcontainers/features/aws-cli:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {},
        // mise is container fabric: it must exist before `uv`/`npm` can run, and it
        // is what makes `mise run check` here identical to `mise run check` in CI.
        // The toolchain it manages is declared in the repo's mise.toml.
        "ghcr.io/devcontainers-extra/features/mise:1": {},
        "ghcr.io/get2knowio/devcontainer-features/ai-clis:2": {
            "omit": "codeRabbit,beads"
        },
        // install/omit: claudeCode, geminiCli, codex, copilot, openCode, codeRabbit, beads, specifyCli
        "ghcr.io/get2knowio/devcontainer-features/modern-cli-tools:2": {},
        // install/omit: bat, ripgrep, fd, fzf, eza, zoxide, neovim, tmux, lazygit, astGrep, jujutsu, zellij, starship
        // (empty options == install all, so starship is included)
        "ghcr.io/get2knowio/devcontainer-features/python-tools:2": {
            "omit": "poetry"
        },
        // install/omit: uv, poetry, ruff, mypy
        "ghcr.io/get2knowio/devcontainer-features/github-actions-tools:2": {}
        // install/omit: act, actionlint
    },
    "containerEnv": {
        // Put Claude Code's config INSIDE the mounted ~/.claude directory.
        // By default the config lives at ~/.claude.json, OUTSIDE that mount, so
        // every container starts unauthenticated even though .credentials.json is
        // shared. Bind-mounting the file directly does not work: a file bind pins
        // to the inode, so the first atomic rewrite orphans the container's view
        // and silently discards writes. Relocating into the directory mount avoids
        // that entirely and shares auth across every devcontainer on the host.
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        // mise prompts for confirmation on a config file it has not seen before.
        // Without this the first agent run blocks forever on that prompt.
        "MISE_TRUSTED_CONFIG_PATHS": "/workspaces"
    },
    "mounts": [
        // Shared Claude Code + gh CLI credentials from the host, so auth survives
        // container rebuilds and is consistent across every devcontainer on this
        // machine. Both are read-WRITE: token refresh writes .credentials.json
        // and hosts.yml respectively.
        "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            }
        }
    },
    // Install the pinned toolchain, then the project's dependencies — via the same
    // `setup` verb CI uses, so a fresh container and a fresh CI runner converge.
    "postCreateCommand": "mise install && mise run setup"
}
